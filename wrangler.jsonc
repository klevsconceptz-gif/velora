{
  // Velora on Cloudflare: static frontend + API proxy. The Python/SQLite API runs
  // elsewhere (see docs/CLOUDFLARE.md) and is reached through this Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velora",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,

  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    // The SPA is hash-routed, but /verify?token=… and /c/<handle> are real paths.
    "not_found_handling": "single-page-application",
    // Static files never invoke the Worker; only the API does.
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    // REQUIRED: https origin of your Velora API (no path). Example: https://velora-api.fly.dev
    "ORIGIN_URL": ""
  },

  // The edge secret lives in Cloudflare Secrets Store, never in this file. The Worker
  // reads it as env.EDGE_SECRET (see cloudflare/worker.js and docs/CLOUDFLARE.md).
  "secrets_store_secrets": [
    {
      "binding": "EDGE_SECRET",
      "store_id": "2cb4fb67701a46419d102cd87be0bb2e",
      "secret_name": "APITOKEN"
    }
  ],

  "observability": { "enabled": true }
}
